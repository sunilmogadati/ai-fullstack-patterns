# Copy this file to .env and fill in real values.
# .env is gitignored; .env.example is committed as the contract.

# --- MongoDB --------------------------------------------------------------
# Local Docker:  mongodb://127.0.0.1:27017/brainwave
# Local install: mongodb://127.0.0.1:27017/brainwave
# Atlas:         mongodb+srv://<user>:<pwd>@<cluster>.mongodb.net/brainwave
MONGODB_URI=mongodb://127.0.0.1:27017/brainwave

# --- Server ---------------------------------------------------------------
PORT=3002

# CORS allow-list (Vite default port for this project is 5175 to coexist
# with the comments-app on 5174). Comma-separated, no spaces.
CORS_ORIGINS=http://localhost:5175

# --- AWS Bedrock (LLM access) --------------------------------------------
# AnthropicBedrock SDK reads AWS_REGION + standard AWS credentials.
# Recommended: use a named AWS profile via aws-sso or AWS_PROFILE.
AWS_REGION=us-west-2

# These two are picked up by the AWS SDK automatically if set; you can also
# rely on AWS_PROFILE + ~/.aws/credentials in development.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=  (if assuming a role)
# AWS_PROFILE=default

# Bedrock-hosted Claude model IDs.
# Haiku is used for summary + patterns (cheap, fast).
# Sonnet is used for prioritize (better multi-criteria reasoning).
BEDROCK_MODEL_HAIKU=anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_SONNET=anthropic.claude-sonnet-4-5-20250929-v1:0
