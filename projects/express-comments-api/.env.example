# Copy this file to .env and fill in real values.
# .env is gitignored; .env.example is committed as the contract.

# MongoDB connection string.
# Local Docker:  mongodb://127.0.0.1:27017/comments
# Local install: mongodb://127.0.0.1:27017/comments
# Atlas:         mongodb+srv://<user>:<password>@<cluster>.mongodb.net/comments
MONGODB_URI=mongodb://127.0.0.1:27017/comments

# Port the API listens on. The react-redux project expects 3001.
PORT=3001

# CORS allow-list. Vite default is 5174; redux-plain-js uses 5173.
# Comma-separated, no spaces. Use "*" only for throwaway demos.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
